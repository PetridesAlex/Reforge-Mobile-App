EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use either the anon JWT key or the newer publishable key from Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_USE_MOCK_AUTH=false

# Production web URL (optional — used for auth redirects when hosting the web app)
# EXPO_PUBLIC_SITE_URL=https://app.reforge.cy

# Local scripts only — never commit or ship in the app
SUPABASE_SERVICE_ROLE_KEY=
SEED_ANDREAS_PASSWORD=
# SEED_ANDREAS_EMAIL=petrides_andreas@hotmail.com

# Optional — invite / password-reset deep link (default: reforge://reset-password)
# INVITE_REDIRECT_URL=reforge://reset-password

# Web dev (Expo web): add these to Supabase → Authentication → Redirect URLs:
# http://localhost:8081/auth/callback
# http://localhost:8081/**

# ── EAS production builds (run once, values from your Supabase project) ──
# eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "https://xxxx.supabase.co"
# eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY --value "sb_publishable_..."
# eas secret:create --scope project --name EXPO_PUBLIC_USE_MOCK_AUTH --value "false"
#
# Build: npm run build:ios:testflight  (or eas build --platform android --profile production)
# Demo UI only (no Supabase): eas build --profile preview-mock
