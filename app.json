{
  "expo": {
    "name": "REFORGE",
    "slug": "reforge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/reforge-app-icon.png",
    "scheme": "reforge",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cy.reforge.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "REFORGE",
        "CFBundleName": "REFORGE",
        "NSPhotoLibraryUsageDescription": "Allow REFORGE to access your photos for your profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cy.reforge.app",
      "icon": "./assets/images/reforge-app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/reforge-app-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "reforge"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/reforge-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/reforge-app-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A",
          "dark": {
            "image": "./assets/images/reforge-app-icon.png",
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow REFORGE to access your photos for your profile picture."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2398e3bd-9e2d-4c06-9be8-b88bf0e89151"
      }
    }
  }
}
